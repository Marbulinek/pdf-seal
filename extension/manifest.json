{
  "manifest_version": 3,
  "name": "PDF Seal Portal",
  "version": "1.0.1",
  "description": "Send the PDF document directly to PDF Seal.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send via PDF Seal Portal",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://pdf-seal-production.up.railway.app/*"],
  "optional_host_permissions": ["*://*/*"]
}

{
  "name": "pdf-seal",
  "description": "PDF editor for preparing documents for signing workflows",
  "version": "1.0.0",
  "build": {
    "command": "npm run build",
    "outputDir": "dist"
  },
  "dev": {
    "command": "npm run dev",
    "port": 3000
  },
  "language": "typescript",
  "framework": "angular + express",
  "dependencies": {
    "core": ["pdf-lib", "express", "multer", "ws"],
    "frontend": ["@angular/core", "@ngrx/signals", "pdfjs-dist"]
  },
  "security": {
    "rateLimiting": true,
    "pathSanitization": true,
    "vendorLibraries": true
  }
}
